generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  TEACHER
  TA
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum ModuleItemType {
  LESSON
  ASSIGNMENT
  QUIZ
  CODE_EXERCISE
  PRACTICE_TEST
  FORUM
  FILE
  EXTERNAL_URL
}

enum CompletionType {
  VIEW
  SUBMIT
  MIN_SCORE
}

enum AssignmentType {
  TEXT
  FILE
  BOTH
}

enum ExerciseStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum CodeLanguage {
  PYTHON3
  JAVASCRIPT
  CPP17
  WEB
  SCRATCH
}

enum CodeSubmissionStatus {
  PENDING
  PROCESSING
  ACCEPTED
  PARTIAL
  WRONG_ANSWER
  COMPILE_ERROR
  RUNTIME_ERROR
  TIME_LIMIT
  INTERNAL_ERROR
  MANUAL_REVIEW
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum LatePolicy {
  NONE
  ALLOW
  DEDUCT
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum PracticeTestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum PracticeQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_MULTI
  SHORT_ANSWER
}

enum QuestionType {
  MULTIPLE_CHOICE_SINGLE
  MULTIPLE_CHOICE_MULTIPLE
  TRUE_FALSE
  TRUE_FALSE_MULTI
  ESSAY
  CODE_PYTHON
  CODE_CPP
  CODE_WEB
  PARSONS
  CODE_FILL
  CODE_DEBUG_PYTHON
  CODE_DEBUG_CPP
  ORDERING
  MATCHING
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum NotificationType {
  QUIZ_GRADED
  ASSIGNMENT_GRADED
  CODE_GRADED
  COURSE_ENROLLED
  ASSIGNMENT_DUE_SOON
  ANNOUNCEMENT
  FORUM_REPLY
  ROOM_BOOKING_SUBMITTED // gửi cho admin khi có đơn mượn phòng mới
  ROOM_BOOKING_APPROVED
  ROOM_BOOKING_REJECTED
  ROOM_BOOKING_CHECKED_OUT // nhắc người mượn mang trả chìa khoá
  ROOM_BOOKING_NO_SHOW
}

enum ActivityAction {
  VIEW_COURSE
  VIEW_LESSON
  START_QUIZ
  SUBMIT_QUIZ
  VIEW_PRACTICE_TEST
  START_PRACTICE_TEST
  SUBMIT_PRACTICE_TEST
  VIEW_ASSIGNMENT
  SUBMIT_ASSIGNMENT
  SUBMIT_CODE
  VIEW_EXERCISE
  LOGIN
}

// Mức độ thành thạo năng lực (thứ tự tăng dần). Điểm quy đổi map ở @lumibach/types.
enum CompetencyLevel {
  NO_EVIDENCE // Không có minh chứng
  BEGINNING // Chưa thành thạo
  APPROACHING // Gần thành thạo
  PROFICIENT // Thành thạo
  ADVANCED // Vượt thành thạo
}

// Chế độ tương tác nhóm của khoá học.
enum GroupMode {
  NO_GROUPS // Không có nhóm
  SEPARATE_GROUPS // Nhóm riêng biệt (chỉ thấy nhóm mình)
  VISIBLE_GROUPS // Nhóm hiện hữu (thấy nhóm khác, chỉ xem)
}

// Vòng đời một đơn mượn phòng / mượn thiết bị. Chuyển trạng thái đi qua state
// machine tường minh ở apps/api/src/modules/rooms/booking-state.ts — đừng gán
// status trực tiếp ở service.
enum RoomBookingStatus {
  PENDING // Chờ duyệt (VẪN GIỮ CHỖ trên lịch)
  APPROVED // Đã duyệt, chờ đến giờ nhận phòng
  CHECKED_IN // Đã nhận phòng/thiết bị
  CHECKED_OUT // Đã trả, chờ admin xác nhận nhận lại chìa khoá
  COMPLETED // Hoàn tất
  REJECTED // Bị từ chối (bắt buộc có lý do)
  CANCELLED // Người mượn tự huỷ
  NO_SHOW // Quá giờ mà không nhận phòng (job cron đánh dấu)
}

// Kiểu dữ liệu của một trường bàn giao động do admin cấu hình.
enum HandoverFieldType {
  NUMBER
  TEXT
  SELECT
  BOOLEAN
}

// Trường bàn giao áp dụng ở lượt nào.
enum HandoverFieldApplies {
  CHECKIN
  CHECKOUT
  BOTH
}

enum HandoverType {
  CHECKIN
  CHECKOUT
}

// Loại đơn mà một lượt bàn giao gắn vào. Xem ghi chú ở model Handover về lý do
// không dùng khoá ngoại đa hình.
enum BookableType {
  ROOM
  EQUIPMENT
}

// ============================================================
// AUTHENTICATION MODELS
// ============================================================

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String? @unique
  passwordHash String

  // Thông tin cá nhân
  firstName   String
  lastName    String
  fullName    String? // tên đầy đủ kiểu Việt Nam: "Nguyễn Văn A"
  avatar      String? // URL ảnh trên MinIO
  phone       String?
  dateOfBirth DateTime?

  // Vai trò và trạng thái
  role          UserRole   @default(STUDENT)
  status        UserStatus @default(PENDING)
  emailVerified DateTime?

  // Metadata
  lastLoginAt DateTime?
  loginCount  Int       @default(0)
  preferences Json? // theme, language, notifications

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  passwordResets         PasswordReset[]
  emailTokens            EmailVerificationToken[]
  auditLogs              AuditLog[]
  activityLogs           ActivityLog[]
  ownedCourses           Course[]                 @relation("CourseOwner")
  enrollments            Enrollment[]
  taAssignments          TeachingAssistant[]
  coTeachingCourses      CourseCoTeacher[]        @relation("CoTeacher")
  quizAttempts           QuizAttempt[]
  practiceTestAttempts   PracticeTestAttempt[]
  submissions            Submission[]             @relation("SubmissionStudent")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  forumTopics            ForumTopic[]             @relation("ForumTopicAuthor")
  forumPosts             ForumPost[]              @relation("ForumPostAuthor")
  competencyAssessments  CompetencyAssessment[]
  competencyLevelTargets CompetencyLevelTarget[]
  groupMemberships       GroupMember[]
  portfolioReflections   PortfolioReflection[]

  // Phòng chức năng — chỉ là quan hệ ngược, KHÔNG thêm cột nào vào bảng User.
  staffProfile              StaffProfile?
  roomRuleEdits             RoomRule[]         @relation("RoomRuleEditor")
  roomBookings              RoomBooking[]      @relation("RoomBookingOwner")
  roomBookingApprovals      RoomBooking[]      @relation("RoomBookingApprover")
  roomKeyReturnConfirms     RoomBooking[]      @relation("RoomBookingKeyReturner")
  equipmentBookings         EquipmentBooking[] @relation("EquipmentBookingOwner")
  equipmentBookingApprovals EquipmentBooking[] @relation("EquipmentBookingApprover")
  equipmentReturnConfirms   EquipmentBooking[] @relation("EquipmentBookingReturner")
  handoversPerformed        Handover[]         @relation("HandoverPerformer")

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userRole   String?
  action     String
  resource   String?
  resourceId String?
  changes    Json? // before/after state
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
}

// ============================================================
// COURSE MODULE
// ============================================================

model CourseCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String? @db.Text
  sortOrder   Int     @default(0)

  parentId String?
  parent   CourseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children CourseCategory[] @relation("CategoryHierarchy")

  courses Course[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([deletedAt])
}

model Course {
  id             String       @id @default(cuid())
  name           String
  shortName      String?
  slug           String       @unique
  description    String?      @db.Text
  thumbnail      String?
  subject        String?
  status         CourseStatus @default(DRAFT)
  isPublic       Boolean      @default(false)
  enrollmentCode String?      @unique
  groupMode      GroupMode    @default(NO_GROUPS)

  // Khi vào khoá học, các chương đổ xuống sẵn (true) hay chỉ hiện tên (false).
  modulesExpandedByDefault Boolean @default(true)

  startDate DateTime?
  endDate   DateTime?
  settings  Json?

  categoryId String
  category   CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  ownerId String
  owner   User   @relation("CourseOwner", fields: [ownerId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?

  enrollments                 Enrollment[]
  teachingAssistants          TeachingAssistant[]
  coTeachers                  CourseCoTeacher[]
  modules                     Module[]
  assignments                 Assignment[]
  quizzes                     Quiz[]
  practiceTests               PracticeTest[]
  questions                   Question[]
  questionCategories          QuestionCategory[]
  exercises                   CodeExercise[]
  activityLogs                ActivityLog[]
  forums                      Forum[]
  forumTopics                 ForumTopic[]
  competencyCategories        CompetencyCategory[]
  competencyAssessmentPeriods CompetencyAssessmentPeriod[]
  groups                      Group[]
  groupings                   Grouping[]
  portfolioReflections        PortfolioReflection[]

  @@index([slug])
  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

model Enrollment {
  id       String           @id @default(cuid())
  userId   String
  courseId String
  status   EnrollmentStatus @default(ACTIVE)

  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?
  progress     Float     @default(0)
  lastAccessAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model TeachingAssistant {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  assignedAt  DateTime @default(now())
  assignedBy  String?
  permissions Json?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CourseCoTeacher {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  assignedAt DateTime @default(now())
  assignedBy String?

  user   User   @relation("CoTeacher", fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// ============================================================
// CONTENT MODULE
// ============================================================

model Module {
  id          String    @id @default(cuid())
  courseId    String
  name        String
  description String?   @db.Text
  position    Int
  isPublished Boolean   @default(false)
  unlockAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items  ModuleItem[]

  @@index([courseId])
  @@index([courseId, position])
}

model ModuleItem {
  id                String         @id @default(cuid())
  moduleId          String
  type              ModuleItemType
  position          Int
  title             String
  lessonId          String?
  externalUrl       String?
  isPublished       Boolean        @default(false)
  requireCompletion Boolean        @default(false)
  completionType    CompletionType @default(VIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentId   String?
  quizId         String?
  codeExerciseId String?
  practiceTestId String?
  forumId        String?

  // Đưa hoạt động vào ngân hàng nội dung của danh mục khoá học: khoá khác cùng
  // nhánh danh mục xem được và nhân bản về chương của mình. Cờ đặt ở ModuleItem
  // chứ không ở từng bảng nội dung vì đây mới là "một hoạt động trong khoá" —
  // và Lesson thì không có courseId để tự biết mình thuộc khoá nào.
  sharedToCategory Boolean @default(false)

  // Cài đặt nhóm theo từng hoạt động (Moodle-style)
  // NO_GROUPS: mọi HS xem được. VISIBLE_GROUPS: chỉ HS thuộc visibleGroups xem.
  // SEPARATE_GROUPS: dùng grouping (chia nhóm trong hoạt động — group submission cho assignment).
  groupMode  GroupMode @default(NO_GROUPS)
  groupingId String?

  module        Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson        Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assignment    Assignment?            @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  quiz          Quiz?                  @relation(fields: [quizId], references: [id], onDelete: SetNull)
  codeExercise  CodeExercise?          @relation(fields: [codeExerciseId], references: [id], onDelete: SetNull)
  practiceTest  PracticeTest?          @relation(fields: [practiceTestId], references: [id], onDelete: SetNull)
  forum         Forum?                 @relation(fields: [forumId], references: [id], onDelete: SetNull)
  grouping      Grouping?              @relation(fields: [groupingId], references: [id], onDelete: SetNull)
  completions   ModuleItemCompletion[]
  visibleGroups ModuleItemGroup[]

  @@index([moduleId])
  @@index([moduleId, position])
  @@index([groupingId])
  @@index([forumId])
  @@index([sharedToCategory])
}

// Bảng nối ModuleItem ↔ Group cho chế độ VISIBLE_GROUPS (chỉ nhóm được liệt kê có thể xem).
model ModuleItemGroup {
  id           String   @id @default(cuid())
  moduleItemId String
  groupId      String
  createdAt    DateTime @default(now())

  moduleItem ModuleItem @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([moduleItemId, groupId])
  @@index([moduleItemId])
  @@index([groupId])
}

model Lesson {
  id               String @id @default(cuid())
  title            String
  content          String @db.Text
  estimatedMinutes Int?
  createdBy        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moduleItems ModuleItem[]
  attachments LessonAttachment[]
}

model LessonAttachment {
  id         String @id @default(cuid())
  lessonId   String
  name       String
  url        String
  mimeType   String
  size       Int
  uploadedBy String

  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model ModuleItemCompletion {
  id           String   @id @default(cuid())
  userId       String
  moduleItemId String
  completedAt  DateTime @default(now())

  moduleItem ModuleItem @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleItemId])
  @@index([userId])
  @@index([moduleItemId])
}

// ============================================================
// ASSIGNMENT MODULE
// ============================================================

model Assignment {
  id           String           @id @default(cuid())
  courseId     String
  title        String
  instructions String           @db.Text
  type         AssignmentType   @default(TEXT)
  status       AssignmentStatus @default(DRAFT)

  maxScore Float @default(100)
  weight   Float @default(1)

  availableFrom DateTime?
  dueDate       DateTime?
  lateDeadline  DateTime?
  latePolicy    LatePolicy @default(NONE)
  latePenalty   Float?

  allowResubmit Boolean @default(false)
  maxAttempts   Int?

  // Giới hạn upload file khi nộp bài (type FILE/BOTH). null = dùng mặc định hệ thống.
  maxFileSizeMb Int?
  maxFiles      Int?

  // Nộp bài theo nhóm: 1 thành viên nộp = cả nhóm tính đã nộp, chấm 1 lần cho cả nhóm.
  groupSubmission Boolean @default(false)
  groupingId      String?

  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grouping              Grouping?              @relation(fields: [groupingId], references: [id], onDelete: SetNull)
  moduleItems           ModuleItem[]
  submissions           Submission[]
  rubric                Rubric?
  competencyLinks       ActivityCompetency[]
  competencyAssessments CompetencyAssessment[]

  @@index([courseId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
}

model Submission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentId     String
  content       String?          @db.Text
  status        SubmissionStatus @default(DRAFT)
  attemptNumber Int              @default(1)

  submittedAt DateTime?
  score       Float?
  feedback    String?   @db.Text
  gradedAt    DateTime?
  gradedBy    String?

  // Khi nộp theo nhóm: nhóm mà bài nộp này đại diện (mọi thành viên dùng chung).
  groupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User             @relation("SubmissionStudent", fields: [studentId], references: [id])
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  files        SubmissionFile[]
  rubricGrades RubricGrade[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([groupId])
}

// ── Rubric ───────────────────────────────────────────────────

model Rubric {
  id             String   @id @default(cuid())
  assignmentId   String?  @unique
  codeExerciseId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment   Assignment?       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  codeExercise CodeExercise?     @relation(fields: [codeExerciseId], references: [id], onDelete: Cascade)
  criteria     RubricCriterion[]
  // App invariant: exactly one of (assignmentId, codeExerciseId) is non-null.
}

model RubricCriterion {
  id          String  @id @default(cuid())
  rubricId    String
  name        String
  description String?
  position    Int     @default(0)

  rubric Rubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels RubricLevel[]
  grades RubricGrade[]

  @@index([rubricId])
}

model RubricLevel {
  id          String  @id @default(cuid())
  criterionId String
  label       String
  points      Float
  description String?
  position    Int     @default(0)

  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  grades    RubricGrade[]

  @@index([criterionId])
}

model RubricGrade {
  id               String   @id @default(cuid())
  submissionId     String?
  codeSubmissionId String?
  criterionId      String
  levelId          String
  gradedBy         String
  gradedAt         DateTime @default(now())

  submission     Submission?     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  codeSubmission CodeSubmission? @relation(fields: [codeSubmissionId], references: [id], onDelete: Cascade)
  criterion      RubricCriterion @relation(fields: [criterionId], references: [id])
  level          RubricLevel     @relation(fields: [levelId], references: [id])

  @@unique([submissionId, criterionId])
  @@unique([codeSubmissionId, criterionId])
  @@index([submissionId])
  @@index([codeSubmissionId])
}

// ── Submission File ──────────────────────────────────────────

model SubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  name         String
  url          String
  mimeType     String
  size         Int
  uploadedBy   String
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ── Quiz Engine ──────────────────────────────────────────────

model Quiz {
  id          String     @id @default(cuid())
  courseId    String
  title       String
  description String?    @db.Text
  status      QuizStatus @default(DRAFT)

  timeLimit        Int? // phút, null = không giới hạn
  maxAttempts      Int? // null = không giới hạn
  passingScore     Float? // null = không yêu cầu
  shuffleQuestions Boolean @default(false)
  shuffleAnswers   Boolean @default(false)
  showResults      Boolean @default(true)

  // Chế độ kiểm tra Safe Exam Browser. Khi bật, học sinh bắt buộc mở bài bằng SEB
  // theo file cấu hình (.seb) đã tải lên (lưu trên MinIO).
  sebEnabled    Boolean @default(false)
  sebConfigUrl  String?
  sebConfigName String?

  availableFrom DateTime?
  dueDate       DateTime?

  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions             QuizQuestion[]
  attempts              QuizAttempt[]
  moduleItems           ModuleItem[]
  competencyLinks       ActivityCompetency[]
  competencyAssessments CompetencyAssessment[]

  @@index([courseId])
  @@index([status])
  @@index([deletedAt])
}

model QuestionCategory {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([courseId])
}

model Question {
  id          String       @id @default(cuid())
  courseId    String
  categoryId  String?
  type        QuestionType
  content     String       @db.Text
  explanation String?      @db.Text
  points      Float        @default(1)

  // Đưa câu hỏi vào ngân hàng chung của danh mục khoá học: khoá khác cùng nhánh
  // danh mục xem được và sao chép về kho riêng. Chỉ là cờ hiển thị — câu hỏi
  // vẫn thuộc về khoá đã tạo ra nó, nơi khác dùng thì nhận một BẢN SAO nên sửa
  // đề bên này không làm đổi đề lớp bên kia giữa chừng.
  sharedToCategory Boolean @default(false)

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // For CODE_* question types
  starterCode  String? @db.Text
  solutionCode String? @db.Text
  timeLimit    Int? // seconds per test case
  memoryLimit  Int? // KB

  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category  QuestionCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options   QuestionOption[]
  quizzes   QuizQuestion[]
  answers   Answer[]
  testCases QuestionTestCase[]

  @@index([courseId])
  @@index([categoryId])
  @@index([type])
  @@index([deletedAt])
  @@index([sharedToCategory])
}

model QuestionTestCase {
  id             String  @id @default(cuid())
  questionId     String
  input          String  @db.Text
  expectedOutput String  @db.Text
  isHidden       Boolean @default(false)
  points         Float   @default(1)
  position       Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  content    String
  isCorrect  Boolean @default(false)
  position   Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizQuestion {
  id         String @id @default(cuid())
  quizId     String
  questionId String
  position   Int    @default(0)
  points     Float? // override câu hỏi gốc

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([quizId, questionId])
  @@index([quizId])
}

model QuizAttempt {
  id        String        @id @default(cuid())
  quizId    String
  studentId String
  status    AttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?
  maxScore    Float?

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User     @relation(fields: [studentId], references: [id])
  answers Answer[]

  @@index([quizId])
  @@index([studentId])
}

// ── Code Exercise Module ─────────────────────────────────────

model CodeExercise {
  id          String         @id @default(cuid())
  courseId    String
  title       String
  description String?        @db.Text
  language    CodeLanguage
  status      ExerciseStatus @default(DRAFT)

  // For PYTHON3 / JAVASCRIPT / CPP17
  starterCode  String? @db.Text
  solutionCode String? @db.Text
  timeLimit    Int     @default(3) // seconds per test case
  memoryLimit  Int     @default(262144) // KB = 256 MB

  // For WEB (HTML + CSS + JS)
  starterHtml String? @db.Text
  starterCss  String? @db.Text
  starterJs   String? @db.Text

  // For SCRATCH (.sb3 file URL on MinIO)
  starterFileUrl String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleItems           ModuleItem[]
  testCases             TestCase[]
  submissions           CodeSubmission[]
  rubric                Rubric?
  competencyLinks       ActivityCompetency[]
  competencyAssessments CompetencyAssessment[]

  @@index([courseId])
  @@index([status])
  @@index([deletedAt])
}

model TestCase {
  id             String  @id @default(cuid())
  codeExerciseId String
  label          String?
  input          String  @db.Text
  expectedOutput String  @db.Text
  isHidden       Boolean @default(true)
  points         Float   @default(1)
  position       Int     @default(0)

  codeExercise CodeExercise     @relation(fields: [codeExerciseId], references: [id], onDelete: Cascade)
  results      TestCaseResult[]

  @@index([codeExerciseId])
}

model CodeSubmission {
  id             String               @id @default(cuid())
  codeExerciseId String
  studentId      String
  language       CodeLanguage
  code           String               @db.Text // JSON for WEB: {html,css,js}
  status         CodeSubmissionStatus @default(PENDING)
  score          Float?
  maxScore       Float?
  feedback       String?              @db.Text
  attemptNumber  Int                  @default(1)
  submittedAt    DateTime             @default(now())
  gradedAt       DateTime?
  gradedBy       String?

  codeExercise CodeExercise     @relation(fields: [codeExerciseId], references: [id], onDelete: Cascade)
  results      TestCaseResult[]
  rubricGrades RubricGrade[]

  @@index([codeExerciseId])
  @@index([studentId])
}

model TestCaseResult {
  id            String               @id @default(cuid())
  submissionId  String
  testCaseId    String
  status        CodeSubmissionStatus
  stdout        String?              @db.Text
  stderr        String?              @db.Text
  compileOutput String?              @db.Text
  time          Float? // seconds
  memory        Int? // KB
  score         Float?
  judge0Token   String?

  submission CodeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase       @relation(fields: [testCaseId], references: [id])

  @@unique([submissionId, testCaseId])
  @@index([submissionId])
}

model Answer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  selectedOptionIds String? // JSON: ["optId1","optId2"] cho MCQ
  booleanAnswer     Boolean? // cho TRUE_FALSE
  textAnswer        String?  @db.Text // cho ESSAY

  isCorrect Boolean?
  score     Float?
  feedback  String?  @db.Text

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ============================================================
// PRACTICE TEST MODULE
// ============================================================

model PracticeTest {
  id          String             @id @default(cuid())
  courseId    String
  title       String
  description String?            @db.Text
  status      PracticeTestStatus @default(DRAFT)

  pdfUrl      String
  pdfName     String
  pdfMimeType String @default("application/pdf")
  pdfSize     Int    @default(0)

  timeLimit   Int?
  maxAttempts Int?
  showResults Boolean @default(true)

  // Chế độ kiểm tra Safe Exam Browser (xem ghi chú ở model Quiz).
  sebEnabled    Boolean @default(false)
  sebConfigUrl  String?
  sebConfigName String?

  availableFrom DateTime?
  dueDate       DateTime?

  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  course                Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleItems           ModuleItem[]
  questions             PracticeTestQuestion[]
  attempts              PracticeTestAttempt[]
  competencyLinks       ActivityCompetency[]
  competencyAssessments CompetencyAssessment[]

  @@index([courseId])
  @@index([status])
  @@index([deletedAt])
}

model PracticeTestQuestion {
  id             String               @id @default(cuid())
  practiceTestId String
  type           PracticeQuestionType
  position       Int                  @default(0)
  prompt         String?              @db.Text
  points         Float                @default(1)
  optionCount    Int                  @default(4)
  statementCount Int                  @default(4)
  correctAnswer  Json
  caseSensitive  Boolean              @default(false)

  practiceTest PracticeTest         @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  answers      PracticeTestAnswer[]

  @@index([practiceTestId])
  @@index([type])
}

model PracticeTestAttempt {
  id             String        @id @default(cuid())
  practiceTestId String
  studentId      String
  status         AttemptStatus @default(GRADED)

  startedAt   DateTime @default(now())
  submittedAt DateTime @default(now())
  score       Float?
  maxScore    Float?

  practiceTest PracticeTest         @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
  student      User                 @relation(fields: [studentId], references: [id])
  answers      PracticeTestAnswer[]

  @@index([practiceTestId])
  @@index([studentId])
}

model PracticeTestAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  selectedOption   String?
  statementAnswers Json?
  textAnswer       String? @db.Text

  isCorrect Boolean?
  score     Float?

  attempt  PracticeTestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PracticeTestQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ============================================================
// NOTIFICATION SYSTEM
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  link      String?
  isRead    Boolean          @default(false)
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  inAppEnabled          Boolean @default(true)
  emailEnabled          Boolean @default(true)
  emailQuizGraded       Boolean @default(true)
  emailAssignmentGraded Boolean @default(true)
  emailCodeGraded       Boolean @default(true)
  emailEnrolled         Boolean @default(true)
  emailDueSoon          Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// ACTIVITY LOG
// ============================================================

model ActivityLog {
  id           String         @id @default(cuid())
  userId       String
  courseId     String?
  action       ActivityAction
  resourceType String? // "lesson" | "quiz" | "assignment" | "exercise"
  resourceId   String?
  resourceName String? // denormalized title for display
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime       @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([courseId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([courseId, createdAt])
}

// ============================================================
// DISCUSSION FORUM
// ============================================================

// Diễn đàn — một hoạt động học tập, gắn vào chương qua ModuleItem giống
// assignment/quiz. Chủ đề (ForumTopic) nằm trong một diễn đàn; forumId để
// null nghĩa là chủ đề cũ ở cấp khoá học, tạo trước khi có model này.
model Forum {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics      ForumTopic[]
  moduleItems ModuleItem[]

  @@index([courseId])
}

model ForumTopic {
  id        String   @id @default(cuid())
  courseId  String
  forumId   String?
  authorId  String
  title     String
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  viewCount Int      @default(0)
  groupId   String? // chủ đề thuộc nhóm nào (theo chế độ nhóm của khoá học)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  forum  Forum?      @relation(fields: [forumId], references: [id], onDelete: Cascade)
  author User        @relation("ForumTopicAuthor", fields: [authorId], references: [id])
  group  Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  posts  ForumPost[]

  @@index([courseId])
  @@index([forumId])
  @@index([authorId])
  @@index([courseId, createdAt])
  @@index([groupId])
}

model ForumPost {
  id        String   @id @default(cuid())
  topicId   String
  authorId  String
  content   String   @db.Text
  isAnswer  Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic   ForumTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author  User        @relation("ForumPostAuthor", fields: [authorId], references: [id])
  parent  ForumPost?  @relation("ForumPostReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies ForumPost[] @relation("ForumPostReplies")

  @@index([topicId])
  @@index([authorId])
  @@index([topicId, createdAt])
}

// ============================================================
// COMPETENCY MODULE — chấm điểm năng lực (CBE)
// ============================================================

// Danh mục năng lực — khởi tạo trong từng khoá học.
model CompetencyCategory {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  description String?  @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course       Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  components   CompetencyComponent[]
  levelTargets CompetencyLevelTarget[]

  @@index([courseId])
}

// Thành phần năng lực — thuộc một danh mục, gom nhóm các chỉ báo cùng một
// khía cạnh (vd "MATH.1.1 — Đặt câu hỏi"). Cấp độ xuất phát/đích và điểm
// năng lực (Chính sách H.A.S) được chấm ở cấp này rồi mới gộp lên danh mục.
model CompetencyComponent {
  id          String   @id @default(cuid())
  categoryId  String
  code        String? // mã thành phần (tuỳ chọn), vd "MATH.1.1"
  name        String // nội dung thành phần, vd "Đặt câu hỏi"
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     CompetencyCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  indicators   CompetencyIndicator[]
  levelTargets CompetencyLevelTarget[]

  @@index([categoryId])
}

// Chỉ báo năng lực — thuộc một thành phần năng lực.
model CompetencyIndicator {
  id          String   @id @default(cuid())
  componentId String
  code        String? // mã chỉ báo (tuỳ chọn), vd "1.1"
  name        String   @db.Text // nội dung chỉ báo
  description String?  @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  component     CompetencyComponent    @relation(fields: [componentId], references: [id], onDelete: Cascade)
  activityLinks ActivityCompetency[]
  assessments   CompetencyAssessment[]

  @@index([componentId])
}

// Liên kết chỉ báo ↔ hoạt động học tập (đa hình: đúng 1 trong 4 FK non-null).
// Rubric 5 mức gắn ở đây (không gắn cố định trên chỉ báo) vì cùng 1 chỉ báo
// có thể được đánh giá bằng rubric khác nhau tuỳ hoạt động/bài cụ thể.
model ActivityCompetency {
  id          String   @id @default(cuid())
  indicatorId String
  createdAt   DateTime @default(now())

  // Rubric 5 mức riêng cho lần gắn chỉ báo này vào hoạt động này.
  rubricNoEvidence  String? @db.Text
  rubricBeginning   String? @db.Text
  rubricApproaching String? @db.Text
  rubricProficient  String? @db.Text
  rubricAdvanced    String? @db.Text

  assignmentId   String?
  quizId         String?
  codeExerciseId String?
  practiceTestId String?

  indicator    CompetencyIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  assignment   Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  quiz         Quiz?               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  codeExercise CodeExercise?       @relation(fields: [codeExerciseId], references: [id], onDelete: Cascade)
  practiceTest PracticeTest?       @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, assignmentId])
  @@unique([indicatorId, quizId])
  @@unique([indicatorId, codeExerciseId])
  @@unique([indicatorId, practiceTestId])
  @@index([indicatorId])
  @@index([assignmentId])
  @@index([quizId])
  @@index([codeExerciseId])
  @@index([practiceTestId])
}

// Đánh giá năng lực của 1 học sinh cho 1 chỉ báo trên 1 hoạt động.
// loại minh chứng (evidenceType) tham chiếu danh sách 5 nhóm ở @lumibach/types.
model CompetencyAssessment {
  id           String          @id @default(cuid())
  indicatorId  String
  studentId    String
  level        CompetencyLevel
  evidenceType String? // key thuộc EVIDENCE_TYPES
  note         String?         @db.Text

  assignmentId   String?
  quizId         String?
  codeExerciseId String?
  practiceTestId String?

  gradedBy  String
  gradedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  indicator    CompetencyIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  student      User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment   Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  quiz         Quiz?               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  codeExercise CodeExercise?       @relation(fields: [codeExerciseId], references: [id], onDelete: Cascade)
  practiceTest PracticeTest?       @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, studentId, assignmentId])
  @@unique([indicatorId, studentId, quizId])
  @@unique([indicatorId, studentId, codeExerciseId])
  @@unique([indicatorId, studentId, practiceTestId])
  @@index([studentId])
  @@index([indicatorId])
  @@index([assignmentId])
  @@index([quizId])
  @@index([codeExerciseId])
  @@index([practiceTestId])
}

// Kỳ đánh giá (học kỳ) — phạm vi trong 1 khoá học, dùng để nhóm các cặp
// cấp độ xuất phát/đích theo thời gian.
model CompetencyAssessmentPeriod {
  id        String    @id @default(cuid())
  courseId  String
  name      String // "Học kỳ 1", "Cuối năm"...
  position  Int       @default(0) // thứ tự trong năm học
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course       Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  levelTargets CompetencyLevelTarget[]

  @@index([courseId])
}

// Cấp độ năng lực xuất phát/đích của 1 học sinh, cho 1 thành phần năng lực,
// tại 1 kỳ đánh giá. categoryId giữ lại (denormalized) để lọc/tổng hợp theo
// danh mục mà không phải join qua component ở mọi câu truy vấn.
model CompetencyLevelTarget {
  id          String   @id @default(cuid())
  periodId    String
  componentId String
  categoryId  String
  studentId   String
  startLevel  Int // thang 1-12
  targetLevel Int // thang 1-12
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  period    CompetencyAssessmentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  component CompetencyComponent        @relation(fields: [componentId], references: [id], onDelete: Cascade)
  category  CompetencyCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  student   User                       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([periodId, componentId, studentId])
  @@index([periodId])
  @@index([componentId])
  @@index([categoryId])
  @@index([studentId])
}

// ============================================================
// GROUP MODULE — phân nhóm trong khoá học
// ============================================================

// Nhóm — thuộc một khoá học. Một học sinh có thể ở nhiều nhóm (qua nhiều grouping).
model Group {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  description String?  @db.Text
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members          GroupMember[]
  groupingLinks    GroupingGroup[]
  submissions      Submission[]
  forumTopics      ForumTopic[]
  moduleItemAccess ModuleItemGroup[]

  @@index([courseId])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// Phân nhóm — tập hợp nhiều Nhóm lại để giao chung một hoạt động.
model Grouping {
  id          String   @id @default(cuid())
  courseId    String
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groups      GroupingGroup[]
  assignments Assignment[]
  moduleItems ModuleItem[]

  @@index([courseId])
}

model GroupingGroup {
  id         String @id @default(cuid())
  groupingId String
  groupId    String

  grouping Grouping @relation(fields: [groupingId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupingId, groupId])
  @@index([groupingId])
  @@index([groupId])
}

// ============================================================
// PORTFOLIO MODULE — hồ sơ học tập cá nhân
// ============================================================

// Tự đánh giá / phản ánh của học sinh (một phần của hồ sơ học tập).
model PortfolioReflection {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId, studentId])
}

// ============================================================
// PHÒNG CHỨC NĂNG (đăng ký mượn phòng & mượn thiết bị)
// ============================================================
//
// Quy ước thời gian của RIÊNG module này: mọi mốc thời gian khai
// `@db.Timestamptz(3)` thay vì `TIMESTAMP(3)` mặc định của Prisma. Lý do bắt
// buộc: ràng buộc chống trùng lịch dùng `tstzrange(...)` ở tầng CSDL, mà hàm đó
// chỉ nhận cột có múi giờ. Đổi lại, mọi so sánh giờ đều tường minh là UTC —
// tránh lặp lại lỗi lệch 7 tiếng đã gặp ở phần giờ mở/đóng hoạt động.

// Hồ sơ công tác do chính giáo viên tự điền. Tách khỏi bảng User để không đụng
// vào bảng dùng chung của toàn hệ thống; quan hệ khai ở đây KHÔNG thêm cột nào
// vào bảng User.
model StaffProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  staffCode  String? // mã nhân viên
  department String? // tổ chuyên môn

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([staffCode])
  @@index([department])
}

model FunctionRoom {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique // dùng làm URL: /rooms/tin-hoc-1
  location    String?
  capacity    Int?
  description String? @db.Text
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  rules             RoomRule[]
  handoverFields    HandoverField[]
  setting           RoomBookingSetting?
  bookings          RoomBooking[]
  equipment         Equipment[]
  equipmentBookings EquipmentBooking[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

// Nội quy phòng — bảng CHỈ GHI THÊM (append-only). Sửa nội quy = tạo bản ghi
// version mới, không UPDATE bản cũ; nhờ vậy đơn đã duyệt vẫn tra ngược được
// đúng bản nội quy người mượn đã chấp nhận. Vì thế model này không có updatedAt.
model RoomRule {
  id          String @id @default(cuid())
  roomId      String
  content     String @db.Text // HTML từ TipTap
  version     Int
  updatedById String

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  room      FunctionRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  updatedBy User         @relation("RoomRuleEditor", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([roomId, version])
  @@index([roomId, createdAt])
}

// Trường bàn giao động do admin cấu hình. roomId = null → áp dụng cho mọi phòng.
model HandoverField {
  id         String               @id @default(cuid())
  roomId     String?
  label      String
  key        String // định danh dùng trong Handover.fieldValues
  dataType   HandoverFieldType
  options    Json? // danh sách lựa chọn khi dataType = SELECT
  isRequired Boolean              @default(false)
  appliesTo  HandoverFieldApplies @default(BOTH)
  sortOrder  Int                  @default(0)
  isActive   Boolean              @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  room FunctionRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, key])
  @@index([roomId, isActive, sortOrder])
}

// Tham số đặt phòng. roomId = null → bản mặc định toàn hệ thống; bản của từng
// phòng ghi đè bản mặc định.
model RoomBookingSetting {
  id     String  @id @default(cuid())
  roomId String? @unique

  openTime             String  @default("07:00") // HH:mm theo giờ Việt Nam
  closeTime            String  @default("17:30")
  slotStepMinutes      Int     @default(30)
  minDurationMinutes   Int     @default(30)
  maxDurationMinutes   Int     @default(300)
  maxAdvanceDays       Int     @default(30)
  allowWeekend         Boolean @default(true)
  checkinWindowMinutes Int     @default(15)
  minPhotosPerHandover Int     @default(1)
  maxPhotosPerHandover Int     @default(5)
  photoRetentionMonths Int     @default(12)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  room FunctionRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

// Đơn mượn phòng.
//
// Chống trùng giờ: ràng buộc EXCLUDE USING gist khai bằng SQL tay trong file
// migration (Prisma không mô hình hoá được) — khoảng thời gian nửa mở
// [start, end) và chỉ chặn giữa các trạng thái còn giữ chỗ.
model RoomBooking {
  id     String @id @default(cuid())
  roomId String
  userId String

  // Chụp lại tại thời điểm nộp đơn, KHÔNG join ngược StaffProfile khi hiển thị:
  // hồ sơ đổi về sau không được phép làm sai lệch đơn đã nộp.
  fullName   String
  staffCode  String?
  department String?
  reason     String  @db.Text

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  status RoomBookingStatus @default(PENDING)

  // Phiên bản nội quy chốt tại thời điểm DUYỆT đơn. Admin sửa nội quy sau đó
  // không ảnh hưởng tới đơn này.
  ruleVersionAccepted Int?

  approvedById String?
  approvedAt   DateTime? @db.Timestamptz(3)
  rejectReason String?   @db.Text

  keyReturnedAt   DateTime? @db.Timestamptz(3)
  keyReturnedById String?

  // Bật khi số liệu bàn giao lúc trả lệch so với lúc nhận.
  hasDiscrepancy  Boolean @default(false)
  adminReviewNote String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  room          FunctionRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user          User         @relation("RoomBookingOwner", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy    User?        @relation("RoomBookingApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  keyReturnedBy User?        @relation("RoomBookingKeyReturner", fields: [keyReturnedById], references: [id], onDelete: SetNull)
  handovers     Handover[]

  @@index([roomId, startAt])
  @@index([userId, startAt])
  @@index([status])
  @@index([department])
}

model Equipment {
  id            String  @id @default(cuid())
  roomId        String
  name          String
  code          String?
  unit          String  @default("cái")
  totalQuantity Int
  description   String? @db.Text
  isActive      Boolean @default(true)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  room  FunctionRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  items EquipmentBookingItem[]

  @@index([roomId, isActive])
  @@index([deletedAt])
}

// Đơn mượn thiết bị. KHÔNG chiếm slot phòng trên lịch (giáo viên mang thiết bị
// đi lớp khác được); ràng buộc là tổng số lượng thiết bị trong các khung giờ
// giao nhau, kiểm ở tầng service bằng khoá bi quan.
model EquipmentBooking {
  id     String @id @default(cuid())
  roomId String
  userId String

  fullName   String
  staffCode  String?
  department String?
  reason     String  @db.Text

  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  status RoomBookingStatus @default(PENDING)

  ruleVersionAccepted Int?

  approvedById String?
  approvedAt   DateTime? @db.Timestamptz(3)
  rejectReason String?   @db.Text

  returnedAt      DateTime? @db.Timestamptz(3)
  returnedById    String?
  hasDiscrepancy  Boolean   @default(false)
  adminReviewNote String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  room       FunctionRoom           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user       User                   @relation("EquipmentBookingOwner", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy User?                  @relation("EquipmentBookingApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  returnedBy User?                  @relation("EquipmentBookingReturner", fields: [returnedById], references: [id], onDelete: SetNull)
  items      EquipmentBookingItem[]
  handovers  Handover[]

  @@index([roomId, startAt])
  @@index([userId, startAt])
  @@index([status])
}

model EquipmentBookingItem {
  id                 String @id @default(cuid())
  equipmentBookingId String
  equipmentId        String
  quantity           Int

  booking   EquipmentBooking @relation(fields: [equipmentBookingId], references: [id], onDelete: Cascade)
  equipment Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([equipmentBookingId, equipmentId])
  @@index([equipmentId])
}

// Một lượt bàn giao (nhận hoặc trả).
//
// Đề xuất ban đầu là khoá ngoại đa hình (bookableType + bookableId). Prisma
// không mô hình hoá được kiểu đó — mất `include` và mất ràng buộc khoá ngoại
// thật. Thay bằng HAI khoá ngoại nullable kèm CHECK "đúng một cái khác NULL"
// (khai trong migration.sql). Cột bookableType giữ lại để lọc cho gọn.
model Handover {
  id           String       @id @default(cuid())
  bookableType BookableType
  type         HandoverType

  roomBookingId      String?
  equipmentBookingId String?

  performedById String
  performedAt   DateTime @default(now()) @db.Timestamptz(3) // LUÔN là giờ server

  ruleAccepted  Boolean @default(false)
  conditionNote String  @db.Text
  fieldValues   Json // { [HandoverField.key]: string | number | boolean }

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  roomBooking      RoomBooking?      @relation(fields: [roomBookingId], references: [id], onDelete: Cascade)
  equipmentBooking EquipmentBooking? @relation(fields: [equipmentBookingId], references: [id], onDelete: Cascade)
  performedBy      User              @relation("HandoverPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  photos           HandoverPhoto[]

  // Mỗi đơn chỉ có tối đa 1 lượt nhận và 1 lượt trả.
  @@unique([roomBookingId, type])
  @@unique([equipmentBookingId, type])
  @@index([performedById])
  @@index([performedAt])
}

// Ảnh minh chứng. Không có URL công khai: file nằm ở bucket riêng, chỉ phục vụ
// qua endpoint có kiểm quyền (chủ đơn + admin).
model HandoverPhoto {
  id         String @id @default(cuid())
  handoverId String

  bucket     String
  objectName String
  mime       String
  size       Int
  sha256     String // phát hiện ảnh trùng / bị chỉnh sửa
  width      Int
  height     Int

  // Giờ client tự khai — CHỈ để đối chiếu, không bao giờ dùng làm mốc nghiệp vụ.
  capturedAtClient DateTime? @db.Timestamptz(3)
  serverReceivedAt DateTime  @default(now()) @db.Timestamptz(3)
  clockSkewSeconds Int? // lệch giữa giờ client và giờ server
  flagged          Boolean   @default(false) // lệch quá ngưỡng → admin xem lại

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([handoverId])
  @@index([sha256])
  @@index([createdAt])
}
