# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (monorepo)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# turbo
.turbo/

# generated Prisma client (regenerated on install)
packages/db/generated/
# compiled package output (built on install)
packages/db/dist/
packages/types/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — chặn hết, chỉ chừa file mẫu và file test
.env
.env.*
!.env.example
!.env.test

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
Thumbs.db
*.stackdump

# Logs
logs/
*.log
# ...nhưng `logs/` ở trên cũng khớp thư mục route Next.js của tab "Logs" trong
# báo cáo khoá học, khiến trang đó không bao giờ được commit: ở máy dev thì vào
# được, còn bản production dựng từ git lại 404. Mở lại đúng đường dẫn nguồn.
!apps/web/src/app/**/reports/logs/
!apps/web/src/app/**/reports/logs/**

# Uploads (dev)
uploads/

# typescript
*.tsbuildinfo
**/next-env.d.ts

# Claude Code
.claude/
.codex-artifacts/

# Scratch files
/scratch/

# Ảnh Docker xuất ra để bê sang máy chủ nội bộ (`docker save`, hàng trăm MB).
# Dựng lại được từ mã nguồn nên không đưa vào git — GitHub cũng chặn file >100MB.
*.tar

# Self-hosted scratch-gui — CHỈ loại mã nguồn đã clone (vài GB).
#
# Bản build ở apps/web/public/scratch-gui/ thì CÓ trong git, cố ý: script
# build:scratch-gui phải clone TurboWarp rồi npm install ~5GB, cần git + Node
# trên máy build. Commit sẵn bản build thì người tiếp nhận chỉ cần `git clone`
# + Docker là chạy được, đúng như DEPLOYMENT.md hứa.
external/scratch-gui/
apps/web/external/scratch-gui/
