# Database
DATABASE_URL="postgresql://lumibach:PASSWORD@localhost:5432/lumibach?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO
# INTERNAL = địa chỉ tiến trình Node dùng để kết nối MinIO (luôn HTTP, trong mạng nội bộ).
# Trình duyệt KHÔNG gọi thẳng MinIO — ảnh/tệp đi qua rewrite /storage/* của Next.js.
MINIO_INTERNAL_ENDPOINT="localhost"
MINIO_INTERNAL_PORT=9000
# Legacy, dùng làm fallback khi không đặt INTERNAL
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET_AVATARS="lumibach-avatars"
MINIO_BUCKET_FILES="lumibach-files"
# Miền công khai phục vụ file MinIO, ví dụ "https://media.lumibach.com". Khi đặt,
# URL file lưu vào DB sẽ là tuyệt đối và trình duyệt tải thẳng từ MinIO qua CDN
# thay vì đi xuyên tiến trình Next.js. Đoạn "/storage/" vẫn được giữ trong đường
# dẫn — Cloudflare cắt nó đi trước khi vào MinIO (xem docs/DOMAIN_SETUP.md).
# ĐỂ TRỐNG ở dev/LAN: URL sinh ra là tương đối và đi qua rewrite /storage/*.
NEXT_PUBLIC_MEDIA_URL=""

# NextAuth - generate với: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
# Bắt buộc =true khi chạy sau reverse proxy / Cloudflare Tunnel
AUTH_TRUST_HOST=true
# Chỉ đặt khi API nằm ở miền con (api.lumibach.com): cookie phiên mặc định là
# host-only nên sẽ không được gửi sang miền con → mọi request API trả 401.
# Ví dụ: ".lumibach.com". ĐỂ TRỐNG ở dev/LAN.
AUTH_COOKIE_DOMAIN=""
# NEXTAUTH_URL: để trống. Khi đặt giá trị, NextAuth luôn dùng đúng giá trị đó và
# bỏ qua host thật của request — máy khác vào bằng IP LAN sẽ bị đá về localhost
# (tức máy của chính họ) sau khi đăng nhập. Bỏ trống + AUTH_TRUST_HOST=true thì
# NextAuth bám theo host đang truy cập, đúng cho cả localhost, IP LAN và tên miền.
# NEXTAUTH_URL="http://localhost:3000"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@lumibach.local"

# App
# Ngoài việc dựng link trong email, giá trị này còn là một trong các origin được
# tin cậy khi kiểm tra URL file (cùng với NEXT_PUBLIC_MEDIA_URL) — đặt sai thì
# URL file tuyệt đối trỏ về chính miền web sẽ bị từ chối.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LumiBach"

# NestJS API (Phase 1+)
API_PORT=4000
# Trình duyệt gọi API.
# - "/api/v1"  → đi qua rewrite của Next.js, cùng origin nên không dính CORS và
#                chạy được cả localhost lẫn IP LAN. Khuyên dùng cho dev.
# - URL tuyệt đối (https://api.lumibach.com/api/v1) → gọi thẳng miền API riêng;
#                BẮT BUỘC đặt kèm AUTH_COOKIE_DOMAIN, nếu không sẽ 401 hết.
NEXT_PUBLIC_API_URL="/api/v1"
# Server Component + route /api/cron/* gọi thẳng NestJS — LUÔN phải là URL tuyệt đối
API_INTERNAL_URL="http://localhost:4000/api/v1"
# Origin WebSocket (socket.io). ĐỂ TRỐNG cho dev/LAN: web tự nối tới đúng host
# đang truy cập ở cổng API, nên chạy được cả localhost lẫn IP LAN. Chỉ đặt khi
# chạy sau reverse-proxy / Cloudflare Tunnel — xem docs/DOMAIN_SETUP.md
NEXT_PUBLIC_WS_URL=""

# Chia sẻ trong mạng LAN: IP của máy chủ, để máy khác tải được tài nguyên dev của
# Next.js (xem IP bằng: ipconfig — Windows / ip addr — Linux). Nhiều giá trị thì
# ngăn cách bằng dấu phẩy.
DEV_ALLOWED_ORIGINS=""

# Origin bổ sung được phép gọi API (ngăn cách bằng dấu phẩy). Ở chế độ dev, mọi
# origin trong mạng LAN đã được cho phép sẵn nên thường không cần điền.
CORS_ORIGINS=""
LOG_LEVEL=debug
# SENTRY_DSN=  # Optional, leave empty to disable Sentry
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Judge0 (setup ở Tuần 13)
JUDGE0_API_URL="http://localhost:2358"
JUDGE0_API_KEY=""

# Cron jobs (/api/cron/*) — bắt buộc đặt, nếu không endpoint dọn thùng rác sẽ từ chối
CRON_SECRET="your-cron-secret"
