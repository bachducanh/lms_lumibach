# Database
DATABASE_URL="postgresql://lumibach:PASSWORD@localhost:5432/lumibach?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO
# INTERNAL = địa chỉ tiến trình Node dùng để kết nối MinIO (luôn HTTP, trong mạng nội bộ).
# Trình duyệt KHÔNG gọi thẳng MinIO — ảnh/tệp đi qua rewrite /storage/* của Next.js.
MINIO_INTERNAL_ENDPOINT="localhost"
MINIO_INTERNAL_PORT=9000
# Legacy, dùng làm fallback khi không đặt INTERNAL
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET_AVATARS="lumibach-avatars"
MINIO_BUCKET_FILES="lumibach-files"

# NextAuth - generate với: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-auth-secret-here"
# Bắt buộc =true khi chạy sau reverse proxy / Cloudflare Tunnel
AUTH_TRUST_HOST=true

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@lumibach.local"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="LumiBach"

# NestJS API (Phase 1+)
API_PORT=4000
# Trình duyệt gọi API. Dev: URL tuyệt đối. Production sau tunnel/proxy: đặt "/api/v1"
# để đi qua rewrite của Next.js (cookie same-origin).
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Server Component + route /api/cron/* gọi thẳng NestJS — LUÔN phải là URL tuyệt đối
API_INTERNAL_URL="http://localhost:4000/api/v1"
# Origin WebSocket (socket.io). Để trống nếu WS đi chung hostname qua tunnel —
# xem docs/DOMAIN_SETUP.md
NEXT_PUBLIC_WS_URL="http://localhost:4000"
LOG_LEVEL=debug
# SENTRY_DSN=  # Optional, leave empty to disable Sentry
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Judge0 (setup ở Tuần 13)
JUDGE0_API_URL="http://localhost:2358"
JUDGE0_API_KEY=""

# Cron jobs (/api/cron/*) — bắt buộc đặt, nếu không endpoint dọn thùng rác sẽ từ chối
CRON_SECRET="your-cron-secret"
